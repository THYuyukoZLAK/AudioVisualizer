<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 音频回放捕获（阶段 1 起正式使用） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      ⚠️ 这里故意**不声明** RECORD_AUDIO —— 实测不需要：
      音频主链路（MediaProjection + AudioPlaybackCaptureConfiguration）在
      granted=false 的情况下照样能抓到目标应用的音频。

      曾经为了验证「Visualizer 效果器」这条备选音频路（它官方要求 RECORD_AUDIO）
      临时声明过，现已确认不采用（2006-10-05 真机实测：能跑，但 maxCaptureRate 只有
      20Hz、且是 8-bit 量化），所以那两项权限和探针一起删了 ——
      声明一个用不上的敏感权限，对用户对应用商店都不是好事。
    -->

    <!-- Android 11+ 包可见性：不声明就查不到网易云的 uid（按 UID 精确捕获需要），
         而且默认元数据链路（MediaBrowser）也需要能解析到它的服务 -->
    <queries>
        <package android:name="com.netease.cloudmusic" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.AndroidApp">
        <!-- 布局按横屏设计（2560×1600），故锁定横屏。
             ⚠️ Android 12+ 在 sw≥600dp 的大屏设备上**允许系统忽略**这个请求
             （平台开关 config_ignoreOrientationRequest），
             所以代码里还有一层兼底：竖屏时会盖一层「请横屏」遮罩，见 MainActivity 的 PortraitGuard。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 音频捕获前台服务（Android 14+ 必须先 startForeground 再 getMediaProjection） -->
        <service
            android:name=".capture.AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 通知使用权：读取 MediaSession 的曲目信息 -->
        <service
            android:name=".playback.NowPlayingListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
