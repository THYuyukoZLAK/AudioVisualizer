<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 音频回放捕获（阶段 1 起正式使用） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      「全局混音」这个**备选**音频源需要下面两项：「屏幕录制捕获」（现在的默认）
      那条路不需要 RECORD_AUDIO（MediaProjection + AudioPlaybackCapture 在 granted=false
      时照样能抓到）。

      ⚠️ RECORD_AUDIO 是**危险权限**，所以只在用户真的选了全局混音时才在运行时申请。
      它不是「录音」： Visualizer 返回的只有 8 位、低精度的可视化数据，
      AOSP 文档也写明「It is not an audio recording interface」；
      但效果器挂在**输出混音**上时，框架强制要求它（保护语音留言之类的隐私音频）。
      MODIFY_AUDIO_SETTINGS 是 normal 权限，装包即给。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Android 11+ 包可见性：不声明就查不到网易云的 uid（按 UID 精确捕获需要），
         而且默认元数据链路（MediaBrowser）也需要能解析到它的服务 -->
    <queries>
        <package android:name="com.netease.cloudmusic" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.AndroidApp">
        <!-- 布局按横屏设计（2560×1600），故锁定横屏。
             ⚠️ Android 12+ 在 sw≥600dp 的大屏设备上**允许系统忽略**这个请求
             （平台开关 config_ignoreOrientationRequest），
             所以代码里还有一层兼底：竖屏时会盖一层「请横屏」遮罩，见 MainActivity 的 PortraitGuard。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 音频捕获前台服务（Android 14+ 必须先 startForeground 再 getMediaProjection） -->
        <service
            android:name=".capture.AudioCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 通知使用权：读取 MediaSession 的曲目信息 -->
        <service
            android:name=".playback.NowPlayingListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
